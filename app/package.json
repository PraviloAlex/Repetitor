{
  "name": "durillo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "test:generator": "node scripts/test-generator.mjs",
    "bump:build-version": "node scripts/bump-build-version.mjs",
    "build": "npm run test:generator && tsc -b && vite build",
